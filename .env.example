# Docent — Samsung Frame TV art manager
# Copy this file to .env and fill in your values.

# Required: Your Samsung Frame TV's IP address
# Find it: TV Settings > General > Network > Network Status
DOCENT_TV_IP=

# Optional (defaults shown):
# DOCENT_TV_PORT=8001
# DOCENT_TV_TIMEOUT=15
# DOCENT_HOST=0.0.0.0
# DOCENT_PORT=8000
