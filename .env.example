# Docent — Samsung Frame TV art manager
# Copy this file to .env and fill in your values.

# Required: Your Samsung Frame TV's IP address
# Find it: TV Settings > General > Network > Network Status
DOCENT_TV_IP=

# Optional (defaults shown):
# DOCENT_TV_PORT=8001
# DOCENT_TV_TIMEOUT=10             # per-attempt timeout in seconds
# DOCENT_TV_MAC=                   # TV MAC address for Wake-on-LAN (find with: arp -n <tv-ip>)
# DOCENT_TV_ATTEMPTS=3             # retry attempts for TV connections
# DOCENT_TV_RETRY_DELAY=2          # seconds between retries
# DOCENT_RELOAD=                   # set to 1 for uvicorn auto-reload (dev only)
# DOCENT_HOST=0.0.0.0
# DOCENT_PORT=8000
# DOCENT_DATA_DIR=                 # directory for data files (default: project root)
